# Copy this file to .env and fill in secrets locally. Never commit .env.

# Telegram: create a replacement token with @BotFather, then message /start to
# your bot. Chat ID is discovered automatically for this username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERNAME=your_telegram_username
# Optional HTTP/HTTPS proxy used only for Telegram, e.g. http://127.0.0.1:7890
TELEGRAM_PROXY_URL=

# How often saved subscriptions are checked (minimum 60 seconds).
CHECK_INTERVAL_SECONDS=120

# Email: use a Gmail App Password, not your normal Google password.
SMTP_USER=
SMTP_PASS=
EMAIL_TO=you@example.com
